# The model. Any OpenAI-compatible chat endpoint works. OpenRouter is the default
# because one key reaches every major model; to use OpenAI, Gemini, Groq or a local
# server instead, point LLM_BASE_URL at it and set LLM_MODEL to one of its models.
# If OPENROUTER_API_KEY is already set in your environment, you can leave this empty.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5

# Web search, the agent's one tool. Get a key at https://app.tavily.com (has a free tier).
TAVILY_API_KEY=

# Optional
# PORT=3000
# ALMANAC_DB=data/almanac.db
